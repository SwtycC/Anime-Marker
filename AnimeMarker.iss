; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.
;
; NOTE: this file is saved as UTF-8 **with BOM** — Inno Setup only treats a
;       script as UTF-8 when the BOM is present, otherwise it reads ANSI and
;       the Chinese strings below turn into mojibake.
;
; NOTE: all relative paths below are relative to THIS file's directory
;       (the project root), so the script keeps working after the repo is
;       moved to another drive / machine.

#define MyAppName "Anime Marker"
#define MyAppVersion "1.1.1"
#define MyAppPublisher "SwtycC"
#define MyAppURL "https://github.com/SwtycC/Anime-Marker"
#define MyAppExeName "AnimeMarker.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{33FC4C6B-8813-4AAE-8B0F-EF5F52DDC215}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; The app writes its data to <exe dir>\data (see "技术文档.md" §12.2), so the
; install directory MUST be user-writable. {localappdata}\Programs needs no
; admin rights and is writable by the current user. Do NOT use {autopf}.
DefaultDirName={localappdata}\Programs\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the install be done in "64-bit mode" on x64 or Windows 11 on Arm.
; This means it should use the native 64-bit Program Files directory and the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
; Uncomment the following line to use a 64-bit installer.
;SetupArchitecture=x64
; Qt 6 / PySide6 require Windows 10 or later. Failing early beats an install
; that cannot start.
MinVersion=10.0
DisableProgramGroupPage=yes
; MIT, plain ASCII. Do NOT use THIRD_PARTY_LICENSES.md here: it is UTF-8
; without BOM and contains Chinese, which Inno would read as ANSI.
; The Qt/LGPL texts ship inside _internal\licenses\ anyway.
LicenseFile=LICENSE
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
OutputDir=Output
OutputBaseFilename=AnimeMarker-Setup-{#MyAppVersion}
SetupIconFile=resources\app.ico
SolidCompression=yes
WizardStyle=modern dynamic
; Close a running AnimeMarker while upgrading, otherwise the files are locked.
CloseApplications=yes
; Version info shown in Explorer -> Properties -> Details.
; NOTE: VersionInfoVersion needs 4 components (a.b.c.d); MyAppVersion has 3,
;       hence the appended ".0".
VersionInfoVersion={#MyAppVersion}.0
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription={#MyAppName} Setup
VersionInfoProductName={#MyAppName}
VersionInfoProductVersion={#MyAppVersion}

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "dist\AnimeMarker\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
; Everything the frozen app needs (PySide6, Qt DLLs, Python runtime, QML,
; licenses) lives here. Omitting it leaves a setup that cannot start.
Source: "dist\AnimeMarker\_internal\*"; DestDir: "{app}\_internal"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files.

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[Code]
// {app}\data is created at runtime, so it is not listed in [Files] and the
// uninstaller would leave it behind. Ask first (default = No), so that a
// reinstall/upgrade never destroys the user's library.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{app}\data');
    if DirExists(DataDir) then
      if MsgBox('是否同时删除配置、数据库与封面缓存？' + #13#10 +
                '(' + DataDir + ')', mbConfirmation, MB_YESNO) = IDYES then
        DelTree(DataDir, True, True, True);
  end;
end;
