/* ==========================================================================
   fusion_dark — 深色现代（默认）
   基线：极简线性 · 1px 细线 · 4/6px 圆角 · 无阴影 · 黑白灰 + 单一强调（白）
   ========================================================================== */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", sans-serif;
    font-size: 13px;
    outline: none;
}

QWidget {
    background-color: #111111;
    color: #FAFAFA;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}

/* ===== 主窗口与导航 ===== */
QMainWindow::separator {
    background: #2A2A2A;
    width: 1px;
    height: 1px;
}

/* 底部悬浮胶囊导航（overlay · §5.8.0 圆角基线的例外：胶囊 + 正圆按钮）
   不透明实色背景：与窗口底色 #111111 拉开层级，保证按钮清晰可读 */
#navPill {
    background: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 27px;  /* 胶囊：高度 54 的一半 */
}
#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;  /* 正圆（40×40） */
}
#navButton:hover {
    border-color: #FAFAFA;
}
#navButton:checked {
    background: #FAFAFA;
    border-color: #FAFAFA;
}

/* ===== 按钮 ===== */
QPushButton {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
    padding: 6px 14px;
    color: #FAFAFA;
}
QPushButton:hover  { border-color: #FAFAFA; }
QPushButton:pressed { background: #222222; }
QPushButton:disabled {
    color: #555555;
    border-color: #2A2A2A;
}
QPushButton[role="primary"] {
    background: #FAFAFA;
    color: #000000;
    border-color: #FAFAFA;
}
QPushButton[role="primary"]:hover { background: #FFFFFF; }

/* ===== 输入控件 ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #FAFAFA;
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}
/* 复选框 / 单选钮（线性描边风，参考 Uiverse 自绘复选框）
   未选中：透明底 + 1px 描边；选中：实色填充 + 对勾 SVG（运行时生成）
   注：QSS 不支持 transition，悬停/选中的状态切换为瞬时（Qt 限制） */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3A3A3A;
    border-radius: 3px;          /* 对应 Uiverse 的 0.25em */
    background: transparent;     /* 未选中透明，与 Uiverse 一致 */
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #FAFAFA;       /* 悬停仅加深线条，不改填充 */
}
QCheckBox::indicator:checked {
    background: #FAFAFA;         /* 选中填充（深色主题用主文字色） */
    border-color: #FAFAFA;
    image: url("@CHECK_DARK@");  /* 深色对勾，配浅色填充 */
}
QCheckBox::indicator:checked:hover {
    background: #FFFFFF;
    border-color: #FFFFFF;
}
QCheckBox::indicator:disabled {
    border-color: #2A2A2A;
    background: transparent;
}
QCheckBox::indicator:checked:disabled {
    background: #555555;
    border-color: #555555;
    image: url("@CHECK_DARK@");
}
/* 单选钮保持圆形，不参与填充对勾逻辑 */
QRadioButton::indicator {
    border-radius: 7px;
}

/* ===== 数值输入框的加减按钮 =====
   NumberField = QLineEdit + 两个独立 #stepButton，间距由布局控制 */
/* 数值输入的加减按钮（NumberField：输入框 + 独立按钮，两者间距由布局控制） */
#stepButton {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    color: #AAAAAA;
    font-size: 16px;
    font-weight: 500;
}
#stepButton:hover  { border-color: #FAFAFA; }
#stepButton:pressed { background: #2E2E2E; }
#stepButton:disabled {
    color: #555555;
    border-color: #2A2A2A;
}

/* ===== 区块分隔线（设置页）===== */
#line, #sectionDivider {
    background: #2A2A2A;
    border: none;
    max-height: 1px;
}

/* ===== 标签 ===== */
QLabel { background: transparent; }
QLabel[role="title"]    { font-size: 16px; font-weight: 500; }
QLabel[role="subtitle"] { color: #888888; }
QLabel[role="hint"]     { color: #666666; font-size: 12px; }

/* ===== 海报卡片 ===== */
#posterCard {
    background: #161616;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
}
#posterCard:hover { border-color: #FAFAFA; }
#posterCard QLabel[role="title"] { font-size: 13px; font-weight: 500; }
#posterCard QLabel[role="meta"]  { color: #666666; font-size: 12px; }

/* ===== 列表 / 表格 ===== */
QListWidget, QTreeWidget, QTableWidget {
    background: #111111;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    gridline-color: #2A2A2A;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    border-bottom: 1px solid #1F1F1F;
    padding: 4px;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: #1A1A1A;
    color: #FAFAFA;
    border-left: 2px solid #FAFAFA;
}
QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background: #161616;
}

/* ===== 集数行 ===== */
#episodeRow { border-bottom: 1px solid #1F1F1F; }
#episodeRow[watched="true"] QLabel { color: #555555; }
#episodeRow[watched="true"] QLabel[role="check"] { color: #FAFAFA; }

/* ===== 动态行 ===== */
#timelineRow { border-bottom: 1px solid #1F1F1F; }
#timelineRow:hover { background: #161616; }

/* ===== 在看卡片 / 订阅源行 / 待确认行 ===== */
#inProgressCard, #sourceRow, #downloadRow {
    background: #161616;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
}
#inProgressCard:hover, #sourceRow:hover { border-color: #FAFAFA; }

/* ===== 状态提示条 ===== */
#alertBar {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-left: 2px solid #FAFAFA;
    border-radius: 4px;
    color: #AAAAAA;
    padding: 8px 12px;
}

/* ===== 滚动条（海报墙 / 设置页 / 在看 / 订阅统一外观）=====
   轨道与两端按钮全部透明，只保留圆角滑块 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #2A2A2A;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #FAFAFA; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: transparent;
    border: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2A2A2A;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #FAFAFA; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: transparent;
    border: none;
}

/* 滚动视图本身不画背景与边框，避免与内容区色差 */
QScrollArea {
    background: transparent;
    border: none;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background: #0D0D0D;
    border-top: 1px solid #2A2A2A;
    color: #888888;
}

/* ===== 菜单 ===== */
QMenuBar {
    background: #111111;
    border-bottom: 1px solid #2A2A2A;
}
QMenuBar::item:selected { background: #1A1A1A; }
QMenu {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
}
QMenu::item:selected {
    background: #FFFFFF;
    color: #000000;
}

/* ===== 进度条 ===== */
QProgressBar {
    background: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    text-align: center;
    color: #888888;
}
QProgressBar::chunk {
    background: #FAFAFA;
    border-radius: 3px;
}

/* ===== Tab ===== */
QTabWidget::pane {
    border: 1px solid #2A2A2A;
    border-radius: 4px;
}
QTabBar::tab {
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    padding: 6px 14px;
    color: #888888;
}
QTabBar::tab:selected {
    color: #FAFAFA;
    border-color: #2A2A2A;
    border-bottom-color: #111111;
}
QTabBar::tab:hover { color: #FAFAFA; }

/* ===== 工具提示 ===== */
QToolTip {
    background: #1A1A1A;
    color: #FAFAFA;
    border: 1px solid #2A2A2A;
    padding: 4px 8px;
}

/* ===== 分隔线 ===== */
QFrame[frameShape="4"], QFrame[frameShape="5"] {  /* HLine / VLine */
    color: #2A2A2A;
    background: #2A2A2A;
    border: none;
}
