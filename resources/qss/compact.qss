/* ==========================================================================
   compact — 紧凑列表
   基线：极简线性 · 1px 细线 · 高密度 · 字号下调一级 · 间距减半
   ========================================================================== */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", sans-serif;
    font-size: 12px;
    outline: none;
}

QWidget {
    background-color: #FFFFFF;
    color: #111111;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* ===== 主窗口与导航 ===== */
#navRail {
    background: #FAFAFA;
    border-right: 1px solid #E5E5E5;
}
#navRail QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    text-align: left;
    color: #666666;
    font-size: 12px;
}
#navRail QPushButton:hover {
    color: #111111;
    border-color: #111111;
}
#navRail QPushButton:checked {
    color: #111111;
    background: #FFFFFF;
    border-color: #111111;
}

/* ===== 按钮 ===== */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    padding: 3px 10px;
    color: #111111;
    font-size: 12px;
}
QPushButton:hover  { border-color: #111111; }
QPushButton:pressed { background: #FAFAFA; }
QPushButton[role="primary"] {
    background: #111111;
    color: #FFFFFF;
    border-color: #111111;
}

/* ===== 输入控件 ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 12px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #111111;
}

/* ===== 标签 ===== */
QLabel { background: transparent; }
QLabel[role="title"]    { font-size: 14px; font-weight: 500; }
QLabel[role="subtitle"] { color: #666666; font-size: 12px; }
QLabel[role="hint"]     { color: #999999; font-size: 11px; }

/* ===== 海报卡片（缩小） ===== */
#posterCard {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 3px;
}
#posterCard:hover { border-color: #111111; }
#posterCard QLabel[role="title"] { font-size: 12px; font-weight: 500; }
#posterCard QLabel[role="meta"]  { color: #999999; font-size: 11px; }

/* ===== 列表（行高压缩） ===== */
QListWidget, QTreeWidget, QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 3px;
    gridline-color: #E5E5E5;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    border-bottom: 1px solid #F0F0F0;
    padding: 2px 4px;
    min-height: 22px;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: #FAFAFA;
    color: #111111;
    border-left: 2px solid #2563EB;
}

/* ===== 集数行 ===== */
#episodeRow { border-bottom: 1px solid #F0F0F0; }
#episodeRow[watched="true"] QLabel { color: #BBBBBB; }
#episodeRow[watched="true"] QLabel[role="check"] { color: #2563EB; }

/* ===== 动态行 ===== */
#timelineRow { border-bottom: 1px solid #F0F0F0; }
#timelineRow:hover { background: #FAFAFA; }

/* ===== 滚动条 ===== */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical {
    background: #E5E5E5;
    border-radius: 3px;
    min-height: 20px;
    margin: 1px;
}
QScrollBar::handle:vertical:hover { background: #111111; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal {
    background: #E5E5E5;
    border-radius: 3px;
    min-width: 20px;
    margin: 1px;
}
QScrollBar::handle:horizontal:hover { background: #111111; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ===== 状态栏 ===== */
QStatusBar {
    background: #FAFAFA;
    border-top: 1px solid #E5E5E5;
    color: #666666;
    font-size: 11px;
}

/* ===== 工具提示 ===== */
QToolTip {
    background: #FFFFFF;
    color: #111111;
    border: 1px solid #E5E5E5;
    padding: 2px 6px;
    font-size: 11px;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #E5E5E5;
    background: #E5E5E5;
    border: none;
}
