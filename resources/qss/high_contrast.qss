/* ==========================================================================
   high_contrast — 高对比度（无障碍）
   基线：极简线性 · 纯黑白 · 2px 边框 · 无装饰
   ========================================================================== */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", sans-serif;
    font-size: 14px;
    outline: none;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}

/* ===== 主窗口与导航 ===== */
#navRail {
    background: #000000;
    border-right: 2px solid #FFFFFF;
}
#navRail QPushButton {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    padding: 10px 14px;
    text-align: left;
    color: #FFFFFF;
}
#navRail QPushButton:hover,
#navRail QPushButton:checked {
    border-color: #FFFFFF;
    background: #FFFFFF;
    color: #000000;
}

/* ===== 按钮 ===== */
QPushButton {
    background: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0;
    padding: 8px 16px;
    color: #FFFFFF;
    font-weight: 500;
}
QPushButton:hover  { background: #FFFFFF; color: #000000; }
QPushButton:pressed { background: #FFFFFF; color: #000000; }
QPushButton:disabled {
    color: #666666;
    border-color: #666666;
}
QPushButton[role="primary"] {
    background: #FFFFFF;
    color: #000000;
    border-color: #FFFFFF;
}
QPushButton[role="primary"]:hover { background: #000000; color: #FFFFFF; }

/* ===== 输入控件 ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0;
    padding: 6px 10px;
    color: #FFFFFF;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #FFFFFF;
    background: #111111;
}
QComboBox QAbstractItemView {
    background: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px; height: 18px;
    border: 2px solid #FFFFFF;
    background: #000000;
}
QCheckBox::indicator:checked {
    background: #FFFFFF;
}

/* ===== 标签 ===== */
QLabel { background: transparent; color: #FFFFFF; }
QLabel[role="title"]    { font-size: 18px; font-weight: 600; }
QLabel[role="subtitle"] { color: #FFFFFF; }
QLabel[role="hint"]     { color: #CCCCCC; }

/* ===== 海报卡片 ===== */
#posterCard {
    background: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0;
}
#posterCard:hover { background: #FFFFFF; }
#posterCard:hover QLabel { color: #000000; }
#posterCard QLabel[role="title"] { font-size: 14px; font-weight: 600; }
#posterCard QLabel[role="meta"]  { color: #CCCCCC; }
#posterCard:hover QLabel[role="meta"] { color: #333333; }

/* ===== 列表 / 表格 ===== */
QListWidget, QTreeWidget, QTableWidget {
    background: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    gridline-color: #FFFFFF;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    border-bottom: 1px solid #FFFFFF;
    padding: 6px;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: #FFFFFF;
    color: #000000;
}
QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background: #222222;
}

/* ===== 集数行 ===== */
#episodeRow { border-bottom: 1px solid #FFFFFF; }
#episodeRow[watched="true"] QLabel { color: #888888; }
#episodeRow[watched="true"] QLabel[role="check"] { color: #FFFFFF; }

/* ===== 动态行 ===== */
#timelineRow { border-bottom: 1px solid #FFFFFF; }
#timelineRow:hover { background: #222222; }

/* ===== 滚动条 ===== */
QScrollBar:vertical { background: #000000; width: 14px; }
QScrollBar::handle:vertical {
    background: #FFFFFF;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #000000; height: 14px; }
QScrollBar::handle:horizontal {
    background: #FFFFFF;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ===== 状态栏 ===== */
QStatusBar {
    background: #000000;
    border-top: 2px solid #FFFFFF;
    color: #FFFFFF;
}

/* ===== 菜单 ===== */
QMenuBar {
    background: #000000;
    border-bottom: 2px solid #FFFFFF;
    color: #FFFFFF;
}
QMenuBar::item:selected { background: #FFFFFF; color: #000000; }
QMenu {
    background: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
}
QMenu::item:selected { background: #FFFFFF; color: #000000; }

/* ===== 进度条 ===== */
QProgressBar {
    background: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    text-align: center;
}
QProgressBar::chunk { background: #FFFFFF; }

/* ===== 工具提示 ===== */
QToolTip {
    background: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    padding: 6px 10px;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #FFFFFF;
    background: #FFFFFF;
    border: none;
}
