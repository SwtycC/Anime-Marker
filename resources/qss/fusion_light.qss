/* ==========================================================================
   fusion_light — 浅色现代
   基线：极简线性 · 1px 细线 · 4/6px 圆角 · 无阴影 · 黑白灰 + 单一强调（#2563EB）
   ========================================================================== */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", sans-serif;
    font-size: 13px;
    outline: none;
}

QWidget {
    background-color: #FAFAFA;
    color: #111111;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* ===== 主窗口与导航 ===== */
QMainWindow::separator {
    background: #E5E5E5;
    width: 1px;
    height: 1px;
}

/* 底部悬浮胶囊导航（overlay · §5.8.0 圆角基线的例外：胶囊 + 正圆按钮）
   不透明纯白背景 + 1px 边框，与 #FAFAFA 窗口底色形成层级 */
#navPill {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 27px;  /* 高度 54 的一半 */
}
#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
}
#navButton:hover {
    border-color: #111111;
}
#navButton:checked {
    background: #111111;
    border-color: #111111;
}

/* ===== 按钮 ===== */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 6px;
    padding: 6px 14px;
    color: #111111;
}
QPushButton:hover  { border-color: #111111; }
QPushButton:pressed { background: #FAFAFA; }
QPushButton:disabled {
    color: #BBBBBB;
    border-color: #E5E5E5;
}
QPushButton[role="primary"] {
    background: #111111;
    color: #FFFFFF;
    border-color: #111111;
}
QPushButton[role="primary"]:hover { background: #000000; }

/* ===== 输入控件 ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #111111;
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
/* 复选框 / 单选钮（线性描边风，参考 Uiverse 自绘复选框）
   未选中：透明底 + 1px 描边；选中：实色填充 + 对勾 SVG（运行时生成）
   注：QSS 不支持 transition，悬停/选中的状态切换为瞬时（Qt 限制） */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #D0D0D0;
    border-radius: 3px;          /* 对应 Uiverse 的 0.25em */
    background: transparent;     /* 未选中透明，与 Uiverse 一致 */
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #111111;       /* 悬停仅加深线条，不改填充 */
}
QCheckBox::indicator:checked {
    background: #2563EB;         /* 选中填充（本风格单一强调色） */
    border-color: #2563EB;
    image: url("@CHECK_LIGHT@"); /* 白色对勾，配蓝色填充 */
}
QCheckBox::indicator:checked:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
}
QCheckBox::indicator:disabled {
    border-color: #E5E5E5;
    background: transparent;
}
QCheckBox::indicator:checked:disabled {
    background: #AAAAAA;
    border-color: #AAAAAA;
    image: url("@CHECK_LIGHT@");
}
QRadioButton::indicator {
    border-radius: 7px;
}

/* ===== 数值输入框的加减按钮 =====
   说明：不使用 QSpinBox 的内嵌按钮（无法与输入框拉开间距），
   改用 NumberField = QLineEdit + 两个独立 #stepButton，
   间距由 QHBoxLayout.setSpacing 控制（对齐「媒体库根目录」那行的效果） */
/* 数值输入的加减按钮（NumberField：输入框 + 独立按钮，两者间距由布局控制） */
#stepButton {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    color: #5F5F5F;
    font-size: 16px;
    font-weight: 500;
}
#stepButton:hover  { border-color: #111111; }
#stepButton:pressed { background: #F0F0F0; }
#stepButton:disabled {
    color: #C0C0C0;
    border-color: #E5E5E5;
}

/* ===== 区块分隔线（设置页）===== */
#line, #sectionDivider {
    background: #E5E5E5;
    border: none;
    max-height: 1px;
}

/* ===== 标签 ===== */
QLabel { background: transparent; }
QLabel[role="title"]    { font-size: 16px; font-weight: 500; }
QLabel[role="subtitle"] { color: #666666; }
QLabel[role="hint"]     { color: #999999; font-size: 12px; }

/* ===== 海报卡片 ===== */
#posterCard {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
}
#posterCard:hover { border-color: #111111; }
#posterCard QLabel[role="title"] { font-size: 13px; font-weight: 500; }
#posterCard QLabel[role="meta"]  { color: #999999; font-size: 12px; }

/* ===== 列表 / 表格 ===== */
QListWidget, QTreeWidget, QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    gridline-color: #E5E5E5;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    border-bottom: 1px solid #F0F0F0;
    padding: 4px;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: #FAFAFA;
    color: #111111;
    border-left: 2px solid #2563EB;
}
QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background: #FAFAFA;
}

/* ===== 集数行 ===== */
#episodeRow { border-bottom: 1px solid #F0F0F0; }
#episodeRow[watched="true"] QLabel { color: #BBBBBB; }
#episodeRow[watched="true"] QLabel[role="check"] { color: #2563EB; }

/* ===== 动态行 ===== */
#timelineRow { border-bottom: 1px solid #F0F0F0; }
#timelineRow:hover { background: #FAFAFA; }

/* ===== 在看卡片 / 订阅源行 / 待确认行 ===== */
#inProgressCard, #sourceRow, #downloadRow {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
}
#inProgressCard:hover, #sourceRow:hover { border-color: #111111; }

/* ===== 状态提示条 ===== */
#alertBar {
    background: #FAFAFA;
    border: 1px solid #E5E5E5;
    border-left: 2px solid #111111;
    border-radius: 4px;
    color: #666666;
    padding: 8px 12px;
}

/* ===== 滚动条（海报墙 / 设置页 / 在看 / 订阅统一外观）=====
   轨道与两端按钮全部透明，只保留 6px 圆角滑块 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #E5E5E5;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #111111; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    background: transparent;
    border: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #E5E5E5;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #111111; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    background: transparent;
    border: none;
}

/* 滚动视图本身不画背景与边框，避免与内容区色差 */
QScrollArea {
    background: transparent;
    border: none;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E5E5;
    color: #666666;
}

/* ===== 菜单 ===== */
QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E5E5;
}
QMenuBar::item:selected { background: #FAFAFA; }
QMenu {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
}
QMenu::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}

/* ===== 进度条 ===== */
QProgressBar {
    background: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    text-align: center;
    color: #666666;
}
QProgressBar::chunk {
    background: #111111;
    border-radius: 3px;
}

/* ===== Tab ===== */
QTabWidget::pane {
    border: 1px solid #E5E5E5;
    border-radius: 4px;
}
QTabBar::tab {
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    padding: 6px 14px;
    color: #666666;
}
QTabBar::tab:selected {
    color: #111111;
    border-color: #E5E5E5;
    border-bottom-color: #FFFFFF;
}
QTabBar::tab:hover { color: #111111; }

/* ===== 工具提示 ===== */
QToolTip {
    background: #FFFFFF;
    color: #111111;
    border: 1px solid #E5E5E5;
    padding: 4px 8px;
}

/* ===== 分隔线 ===== */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #E5E5E5;
    background: #E5E5E5;
    border: none;
}
